; GeoCommander: procedural tactical arena.
config_version=5

[application]
config/name="GeoCommander"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]
GameSettings="*res://scripts/core/game_settings.gd"
MatchSession="*res://scripts/core/match_session.gd"
LLMService="*res://scripts/core/llm_service.gd"
LaboratoryStore="*res://scripts/lab/laboratory_store.gd"
SignalBus="*res://scripts/core/signal_bus.gd"
KeybindManager="*res://scripts/core/keybind_manager.gd"
TacticalBrain="*res://scripts/core/tactical_brain.gd"

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1440
window/size/window_height_override=810
window/size/min_width=1280
window/size/min_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]
renderer/rendering_method="forward_plus"
rendering_device/driver.macos="metal"
viewport/hdr_2d=true
anti_aliasing/quality/msaa_2d=2
environment/defaults/default_clear_color=Color(0.03, 0.04, 0.06, 1)

[layer_names]
2d_physics/layer_1="TEAM_BLUE_UNIT"
2d_physics/layer_2="TEAM_RED_UNIT"
2d_physics/layer_3="PRISM_BARRIER"
2d_physics/layer_4="ENERGY_PRISM"
2d_physics/layer_5="ARENA_BOUNDS"
